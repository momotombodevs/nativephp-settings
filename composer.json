{
    "name": "momotombo/nativephp-settings",
    "description": "Local typed settings for NativePHP Mobile applications.",
    "type": "nativephp-plugin",
    "license": "MIT",
    "authors": [
        {
            "name": "Momotombo"
        }
    ],
    "require": {
        "php": "^8.2",
        "nativephp/mobile": "^4.5"
    },
    "autoload": {
        "psr-4": {
            "Momotombo\\NativephpSettings\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Momotombo\\NativephpSettings\\SettingsServiceProvider"
            ]
        },
        "nativephp": {
            "manifest": "nativephp.json"
        }
    },
    "require-dev": {
        "pestphp/pest": "^3.0"
    },
    "scripts": {
        "test": "pest"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
